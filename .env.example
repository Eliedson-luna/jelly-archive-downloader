# Copie para .env e ajuste. Variáveis vazias são ignoradas (a interface manda).

# Fuso horário do servidor
TZ=America/Sao_Paulo

# Porta da interface web (o qBittorrent já usa 8080 por padrão)
PORT=8088

# Pasta no HOST onde ficam as configurações, o histórico e o cache (SQLite).
# É montada em /data dentro do container. Apagar essa pasta zera as configurações.
DATA_DIR_HOST=./data

# UID/GID do usuário dono da pasta DATA_DIR_HOST no host
PUID=1000
PGID=1000

# qBittorrent no host (Web UI habilitada).
# Deixe comentado para configurar usuário/senha/URL pela interface web
# (Configurações). Se definir aqui, o campo correspondente fica somente-leitura.
# QBT_URL=http://127.0.0.1:8080
# QBT_USER=admin
# QBT_PASS=

# Caminho do HOST onde o qBittorrent salva os downloads
# (não é um caminho dentro do container)
DOWNLOAD_DIR=

# Opcional: sobrescrever a URL de busca JSON do archive.org
# Precisa conter {query}
SEARCH_URL=
